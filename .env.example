# Docker Compose Configuration
# COMPOSE_FILE selects which compose files are layered for a bare `docker compose` command.
# The default below runs the DEVELOPMENT stack (Vite dev server on :5173). For production,
# either change this to the prod override or pass the files explicitly, e.g.:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Name of the external Docker network the web container joins (e.g. for an nginx reverse
# proxy to reach it). Create it once before the first `up`:
#   docker network create "$SHARED_NETWORK_NAME"
SHARED_NETWORK_NAME=cadence-cards-shared

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cadence_cards

# Auth.js/SvelteKit Configuration
# Generate a random string for AUTH_SECRET (e.g., using: openssl rand -base64 32)
AUTH_SECRET=change_me_generate_random_string

# Application origin URL for CSRF protection
# Development: http://localhost:3000
# Production: https://your.domain.name
ORIGIN=http://localhost:3000

# Public Registration
# Set to "true" to allow public user registration, "false" to disable
ENABLE_PUBLIC_REGISTRATION=false

# Claude.AI API Configuration
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=change_me_your_claude_api_key
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=4000
